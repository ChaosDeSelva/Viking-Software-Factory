    "test:stress": "node tests/stress.mjs",
    "release:local": "node scripts/release.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:fleet": "node tests/fleet.mjs",
    "test:accessibility": "node tests/accessibility.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
