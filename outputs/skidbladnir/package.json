{
  "name": "skidbladnir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build apps/web --outDir ../../dist --emptyOutDir && node scripts/write-notices.mjs",
    "start": "node apps/api/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview:site": "node scripts/preview-site.mjs",
    "test:browser": "node tests/browser.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test:browser:isolated": "node tests/browser-isolated.mjs",
    "format:check": "prettier --check apps/web packages/contracts tests/web.test.mjs tests/browser-isolated.mjs scripts/write-notices.mjs eslint.config.js jsconfig.json .prettierrc.json"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "3.1152.0",
    "@aws-sdk/credential-providers": "3.1152.0",
    "@factory/docs": "file:vendor/factory/factory-docs-0.1.5.tgz",
    "@factory/ui": "file:vendor/factory/factory-ui-0.1.6.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
