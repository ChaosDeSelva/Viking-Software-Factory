{
  "name": "mimir",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run build --output-logs=errors-only && node scripts/coverage.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "release:local": "node scripts/release-local.mjs",
    "qa:smoke": "node scripts/qa-smoke.mjs",
    "test:release": "vitest run --config scripts/vitest.config.mjs",
    "chaos": "turbo run chaos",
    "licenses:check": "node scripts/licenses.mjs",
    "sbom": "node scripts/sbom.mjs",
    "test:supply-chain": "vitest run --config scripts/vitest.config.mjs scripts/supply-chain.test.mjs",
    "bench": "turbo run build --filter=@mimir/server^... --output-logs=errors-only && pnpm --filter @mimir/server bench",
    "bench:check": "turbo run build --filter=@mimir/server^... --output-logs=errors-only && pnpm --filter @mimir/server bench:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
