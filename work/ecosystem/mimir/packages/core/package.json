{
  "name": "@mimir/core",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/store/migrations','dist/store/migrations',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@mimir/protocol": "workspace:*",
    "better-sqlite3": "^13.0.3"
  }
}
