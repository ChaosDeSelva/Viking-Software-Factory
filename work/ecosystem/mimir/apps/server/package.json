{
  "name": "@mimir/server",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsc -p tsconfig.build.json && vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "chaos": "vitest run --config vitest.chaos.config.ts",
    "bench": "node --expose-gc --import tsx bench/run.ts",
    "bench:check": "node --expose-gc --import tsx bench/run.ts --check"
  },
  "dependencies": {
    "@mimir/brokkr-verifier": "workspace:*",
    "@mimir/core": "workspace:*",
    "@mimir/fake-runtime": "workspace:*",
    "@mimir/git": "workspace:*",
    "@mimir/herdr-adapter": "workspace:*",
    "@mimir/protocol": "workspace:*",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@brokkr/sdk": "0.1.0",
    "@mimir/testing": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
