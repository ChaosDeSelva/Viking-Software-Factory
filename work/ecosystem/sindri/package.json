{
  "name": "sindri",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "pnpm build && (vitest run --config vitest.coverage.config.mjs --coverage; s=$?; node scripts/coverage-summary.mjs; exit $s)",
    "test:scripts": "vitest run --config scripts/vitest.config.mjs scripts/coverage-summary.test.mjs scripts/coverage-config.test.mjs scripts/lib/*.test.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "licenses:check": "node scripts/licenses.mjs",
    "sbom": "node scripts/sbom.mjs",
    "test:supply-chain": "vitest run --config scripts/vitest.config.mjs scripts/supply-chain.test.mjs",
    "release:local": "node scripts/release-local.mjs",
    "test:acceptance": "pnpm --filter @sindri/server test:acceptance",
    "test:release": "vitest run --config scripts/vitest.config.mjs scripts/release-local.test.mjs",
    "qa:smoke": "node scripts/qa-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
