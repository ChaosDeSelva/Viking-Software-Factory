{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/harnesses/**"]
    },
    "@brokkr/registry#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/harnesses/**",
        "$TURBO_ROOT$/tests/*.ts",
        "$TURBO_ROOT$/profiles/**"
      ]
    },
    "@brokkr/cli#test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/harnesses/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
