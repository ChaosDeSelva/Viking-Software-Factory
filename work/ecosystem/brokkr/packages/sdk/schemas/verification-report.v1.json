{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brokkr.local/schemas/verification-report.v1.json",
  "title": "Brokkr VerificationReport",
  "description": "Brokkr verification report, schemaVersion \"1.0\" (spec §10.2).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "harness": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "lockDigest": {
          "type": "string"
        }
      },
      "required": ["name", "version", "lockDigest"],
      "additionalProperties": false
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        },
        "required": ["name", "version", "digest"],
        "additionalProperties": false
      }
    },
    "repository": {
      "type": "object",
      "properties": {
        "commitSha": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string"
        },
        "dirtyTreeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": ["commitSha"],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "verdict": {
      "type": "string",
      "enum": ["passed", "failed", "incomplete", "blocked"]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trustMode": {
      "type": "string",
      "enum": ["developer", "workspace-untrusted"]
    },
    "interrupted": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "required": {
            "type": "boolean"
          },
          "requiredBy": {
            "type": "string",
            "enum": ["harness", "policy"]
          },
          "state": {
            "type": "string",
            "enum": ["passed", "failed", "errored", "skipped", "cancelled", "timed_out"]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "signal": {
            "type": ["string", "null"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "enum": [
              "missing_tool",
              "missing_script",
              "condition_not_met",
              "policy_denied",
              "untrusted_source",
              "exception",
              "not_run",
              "timeout",
              "cancelled",
              "spawn_error",
              "cwd_rejected",
              "network_denied",
              "invalid_command",
              "orphaned_descendants",
              "not_applicable"
            ]
          },
          "message": {
            "type": "string"
          },
          "exceptionId": {
            "type": "string"
          },
          "log": {
            "type": "string",
            "minLength": 1
          },
          "outputBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "truncated": {
            "type": "boolean"
          },
          "maxRssBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "secretFindings": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["id", "required", "state", "command", "cwd", "from", "durationMs"],
        "additionalProperties": false
      }
    },
    "policyDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "policy": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "enum": ["before", "runtime", "after"]
          },
          "outcome": {
            "type": "string",
            "enum": ["allow", "deny", "require_approval", "approved", "waived", "unmet", "warn"]
          },
          "layer": {
            "type": "string",
            "enum": ["system", "organization", "project", "harness", "task"]
          },
          "checkId": {
            "type": "string"
          },
          "exceptionId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["policy", "stage", "outcome", "layer", "message"],
        "additionalProperties": false
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "policy": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "minLength": 1
              },
              "task": {
                "type": "string",
                "minLength": 1
              },
              "checkId": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "approvedBy": {
            "type": "string",
            "minLength": 1
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "origin": {
            "type": "string",
            "enum": ["workspace_supplied", "external"]
          },
          "appliedTo": {
            "type": "object",
            "properties": {
              "task": {
                "type": "string"
              },
              "harnesses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "checkId": {
                "type": "string"
              }
            },
            "required": ["harnesses"],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "policy",
          "scope",
          "reason",
          "approvedBy",
          "approvedAt",
          "expiresAt",
          "evidence",
          "appliedTo"
        ],
        "additionalProperties": false
      }
    },
    "policySources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["exceptions", "project-policy", "organization-policy"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "enum": ["workspace_supplied", "external"]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": ["kind", "path", "origin", "digest"],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "producedBy": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["log", "report", "test-result", "screenshot", "other"]
          }
        },
        "required": ["path", "sha256", "bytes", "producedBy", "kind"],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "errored": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["passed", "failed", "skipped", "errored"],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "brokkrVersion": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        }
      },
      "required": ["brokkrVersion", "node", "platform", "arch"],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "harness",
    "harnesses",
    "repository",
    "startedAt",
    "completedAt",
    "verdict",
    "reasons",
    "checks",
    "policyDecisions",
    "exceptions",
    "evidence",
    "summary",
    "environment",
    "warnings"
  ],
  "additionalProperties": false
}
