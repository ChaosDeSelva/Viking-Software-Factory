{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brokkr.local/schemas/selection.v1.json",
  "title": "Brokkr Selection",
  "description": "Result of Brokkr.resolve: harnesses, skills, lock and rationale.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "taskTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "policies": {
          "type": "object",
          "properties": {
            "network": {
              "type": "string",
              "enum": ["allow", "deny"]
            },
            "destructiveCommands": {
              "type": "string",
              "enum": ["allow", "deny"]
            },
            "allowedCommands": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "requireApprovalFor": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "requiredCheckIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            },
            "reviewRequired": {
              "type": "boolean"
            },
            "waivable": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "nonWaivable": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowNetworkFor": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["id", "title", "description"],
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "harnesses": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "description": {
            "type": "string"
          },
          "taskTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "enum": ["builtin", "user", "project", "external"]
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "trust": {
            "type": "string",
            "enum": ["trusted", "untrusted"]
          },
          "executionAllowed": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": ["id", "required"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "version",
          "digest",
          "description",
          "taskTypes",
          "source",
          "sourceRef",
          "trust",
          "executionAllowed",
          "checks"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string"
          },
          "requiredBy": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        },
        "required": ["name", "version", "digest", "reason", "score"],
        "additionalProperties": false
      }
    },
    "lock": {
      "type": "object",
      "properties": {
        "lockVersion": {
          "type": "number",
          "const": 2
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "harnesses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "version": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name", "version", "digest", "source"],
            "additionalProperties": false
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "version": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": ["name", "version", "digest"],
            "additionalProperties": false
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["id", "version"],
            "additionalProperties": false
          }
        },
        "profile": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": ["name", "digest"],
          "additionalProperties": false
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": ["lockVersion", "generatedAt", "harnesses", "skills", "adapters", "digest"],
      "additionalProperties": false
    },
    "rationale": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["harness", "skill"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "selected": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        },
        "required": ["kind", "name", "selected", "reason"],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["schemaVersion", "task", "harnesses", "skills", "lock", "rationale", "warnings"],
  "additionalProperties": false
}
